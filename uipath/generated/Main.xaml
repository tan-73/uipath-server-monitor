      <x:String>GlobalConstantsNamespace</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Collections</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.Xml</AssemblyReference>
      <AssemblyReference>System.Xml.Linq</AssemblyReference>
      <AssemblyReference>System.Xaml</AssemblyReference>
      <AssemblyReference>System.Net.Primitives</AssemblyReference>
      <AssemblyReference>System.Net.Requests</AssemblyReference>
      <AssemblyReference>System.Net.WebProxy</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Workflow</AssemblyReference>
      <AssemblyReference>UiPath.Platform</AssemblyReference>
      <AssemblyReference>UiPath.Web.Activities</AssemblyReference>
      <AssemblyReference>Newtonsoft.Json</AssemblyReference>
      <AssemblyReference>PresentationFramework</AssemblyReference>
      <AssemblyReference>WindowsBase</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Homelab Health Monitor - Phase 3">
    <Sequence.Variables>
      <Variable x:TypeArguments="s:String[]" Name="serviceDefinitions" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Name="previousStates" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Double)" Name="responseTimeTotals" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Int32)" Name="responseTimeCounts" />
      <Variable x:TypeArguments="x:String" Name="serviceName" />
      <Variable x:TypeArguments="x:String" Name="endpoint" />
      <Variable x:TypeArguments="uwahm:HttpResponseSummary" Name="httpResponse" />
      <Variable x:TypeArguments="njl:JObject" Name="healthJson" />
      <Variable x:TypeArguments="x:String" Name="currentState" />
      <Variable x:TypeArguments="x:String" Name="reportedState" />
      <Variable x:TypeArguments="x:String" Name="previousState" />
      <Variable x:TypeArguments="x:String" Name="responseBody" />
      <Variable x:TypeArguments="x:String" Name="reason" />
      <Variable x:TypeArguments="x:String" Name="transitionAction" />
      <Variable x:TypeArguments="x:String" Name="timestampUtc" />
      <Variable x:TypeArguments="x:String" Name="csvLine" />
      <Variable x:TypeArguments="x:String" Name="runId" />
      <Variable x:TypeArguments="x:String" Name="logPath" />
      <Variable x:TypeArguments="x:String" Name="firstIncidentUtc" />
      <Variable x:TypeArguments="x:String" Name="lastIncidentUtc" />
      <Variable x:TypeArguments="x:Int32" Name="httpStatus" />
      <Variable x:TypeArguments="x:Int32" Name="currentCycle" />
      <Variable x:TypeArguments="x:Int32" Name="maxCycles" />
      <Variable x:TypeArguments="x:Int32" Name="totalChecks" />
      <Variable x:TypeArguments="x:Int32" Name="healthyChecks" />
      <Variable x:TypeArguments="x:Int32" Name="degradedChecks" />
      <Variable x:TypeArguments="x:Int32" Name="downChecks" />
      <Variable x:TypeArguments="x:Int32" Name="incidentCount" />
      <Variable x:TypeArguments="x:Int32" Name="recoveryCount" />
      <Variable x:TypeArguments="x:Int64" Name="responseTimeMs" />
      <Variable x:TypeArguments="x:Double" Name="pollIntervalSeconds" />
      <Variable x:TypeArguments="s:DateTime" Name="requestStartedUtc" />
      <Variable x:TypeArguments="x:Boolean" Name="alertRequired" />
    </Sequence.Variables>

    <Assign DisplayName="Initialize Service List">
      <Assign.To><OutArgument x:TypeArguments="s:String[]">[serviceDefinitions]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="s:String[]" xml:space="preserve">[New String() {
"demo-alpha|http://100.103.92.83:18081/health",
"demo-beta|http://100.103.92.83:18082/health",
"demo-gamma|http://100.103.92.83:18083/health"
}]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Initialize Previous States">
      <Assign.To><OutArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[previousStates]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" xml:space="preserve">[New Dictionary(Of String, String) From {
{"demo-alpha", "Unknown"},
{"demo-beta", "Unknown"},
{"demo-gamma", "Unknown"}
}]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Initialize Response Time Totals">
      <Assign.To><OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Double)">[responseTimeTotals]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="scg:Dictionary(x:String, x:Double)">[New Dictionary(Of String, Double) From {{"demo-alpha", 0.0}, {"demo-beta", 0.0}, {"demo-gamma", 0.0}}]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Initialize Response Time Counts">
      <Assign.To><OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)">[responseTimeCounts]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)">[New Dictionary(Of String, Integer) From {{"demo-alpha", 0}, {"demo-beta", 0}, {"demo-gamma", 0}}]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Set Poll Interval Seconds">
      <Assign.To><OutArgument x:TypeArguments="x:Double">[pollIntervalSeconds]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Double">10.0</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Set Maximum Cycles">
      <Assign.To><OutArgument x:TypeArguments="x:Int32">[maxCycles]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Int32">18</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Create Run ID">
      <Assign.To><OutArgument x:TypeArguments="x:String">[runId]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[Guid.NewGuid.ToString("N")]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Set Log Path">
      <Assign.To><OutArgument x:TypeArguments="x:String">[logPath]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[Path.Combine(Environment.CurrentDirectory, "monitoring-log-" &amp; runId &amp; ".csv")]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Initialize First Incident">
      <Assign.To><OutArgument x:TypeArguments="x:String">[firstIncidentUtc]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[String.Empty]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Initialize Last Incident">
      <Assign.To><OutArgument x:TypeArguments="x:String">[lastIncidentUtc]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[String.Empty]</InArgument></Assign.Value>
    </Assign>
    <ui:AppendLine DisplayName="Write CSV Header" FileName="[logPath]" Text="TimestampUtc,Service,PreviousState,CurrentState,HttpStatus,ResponseTimeMs,Reason,AlertSent,TransitionAction,RunId" />
    <WriteLine DisplayName="Write Run Start" Text="[&quot;Monitor started | RunId=&quot; &amp; runId &amp; &quot; | Cycles=&quot; &amp; maxCycles.ToString &amp; &quot; | IntervalSeconds=&quot; &amp; pollIntervalSeconds.ToString]" />

    <While DisplayName="Monitoring Loop" Condition="[currentCycle &lt; maxCycles]">
      <Sequence DisplayName="Monitoring Cycle">
        <WriteLine DisplayName="Write Cycle Start" Text="[&quot;Starting cycle &quot; &amp; (currentCycle + 1).ToString &amp; &quot; of &quot; &amp; maxCycles.ToString]" />
        <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For Each Monitored Service" Values="[serviceDefinitions]">
          <ui:ForEach.Body>
            <ActivityAction x:TypeArguments="x:String">
              <ActivityAction.Argument>
                <DelegateInArgument x:TypeArguments="x:String" Name="serviceDefinition" />
              </ActivityAction.Argument>
              <Sequence DisplayName="Check Current Service">
                <Assign DisplayName="Extract Service Name">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[serviceName]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[serviceDefinition.Split("|"c)(0)]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Extract Service Endpoint">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[endpoint]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[serviceDefinition.Split("|"c)(1)]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Read Previous State">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[previousState]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[previousStates(serviceName)]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Reset Current State">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[currentState]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">Unknown</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Reset Reported State">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[reportedState]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[String.Empty]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Reset HTTP Status">
                  <Assign.To><OutArgument x:TypeArguments="x:Int32">[httpStatus]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Int32">0</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Reset Response Body">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[responseBody]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[String.Empty]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Reset Reason">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[reason]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[String.Empty]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Record Request Start">
                  <Assign.To><OutArgument x:TypeArguments="s:DateTime">[requestStartedUtc]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="s:DateTime">[DateTime.UtcNow]</InArgument></Assign.Value>
                </Assign>

                <TryCatch DisplayName="Request and Classify Service">
                  <TryCatch.Try>
                    <Sequence DisplayName="HTTP Response Received">
                      <uwah:NetHttpRequest BasicAuthPassword="{x:Null}" BasicAuthSecurePassword="{x:Null}" BasicAuthUsername="{x:Null}" BinaryPayload="{x:Null}" ClientCertPassword="{x:Null}" ClientCertPath="{x:Null}" ClientCertSecurePassword="{x:Null}" Cookies="{x:Null}" CustomNegotiatedAuthCredentials="{x:Null}" FilePath="{x:Null}" FormData="{x:Null}" Headers="{x:Null}" LocalFiles="{x:Null}" OAuthToken="{x:Null}" OutputFileName="{x:Null}" OutputFileTargetFolder="{x:Null}" Parameters="{x:Null}" PathResource="{x:Null}" ProxyConfiguration="{x:Null}" ResourceFiles="{x:Null}" TextPayload="{x:Null}" AuthenticationType="None" ContinueOnError="False" DisableSslVerification="False" DisplayName="GET Service Health" EnableCookies="False" FileOverwrite="AutoRename" FollowRedirects="False" FormDataParts="[New List (Of FormDataPart) From {New FileFormDataPart(), New BinaryFormDataPart(), New TextFormDataPart()}]" InitialDelay="500" MaxRedirects="0" MaxRetryAfterDelay="30000" Method="GET" Multiplier="2" PreferRetryAfterValue="False" RequestBodyType="None" RequestUrl="[endpoint]" Result="[httpResponse]" RetryCount="0" RetryPolicyType="None" RetryStatusCodes="[New List (Of System.Net.HttpStatusCode)]" SaveRawRequestResponse="False" SaveResponseAsFile="False" TextPayloadContentType="application/json" TextPayloadEncoding="UTF-8" TlsProtocol="Automatic" UseJitter="False" UseOsNegotiatedAuthCredentials="True">
                        <uwah:NetHttpRequest.TimeoutInMiliseconds>
                          <InArgument x:TypeArguments="s:Nullable(x:Int32)">
                            <Literal x:TypeArguments="s:Nullable(x:Int32)" Value="3000" />
                          </InArgument>
                        </uwah:NetHttpRequest.TimeoutInMiliseconds>
                      </uwah:NetHttpRequest>
                      <Assign DisplayName="Measure HTTP Response Time">
                        <Assign.To><OutArgument x:TypeArguments="x:Int64">[responseTimeMs]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Int64">[CLng((DateTime.UtcNow - requestStartedUtc).TotalMilliseconds)]</InArgument></Assign.Value>
                      </Assign>
                      <Assign DisplayName="Capture HTTP Status">
                        <Assign.To><OutArgument x:TypeArguments="x:Int32">[httpStatus]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Int32">[Convert.ToInt32(httpResponse.StatusCode)]</InArgument></Assign.Value>
                      </Assign>
                      <Assign DisplayName="Capture Response Body">
                        <Assign.To><OutArgument x:TypeArguments="x:String">[responseBody]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:String">[httpResponse.TextContent]</InArgument></Assign.Value>
                      </Assign>
                      <ui:DeserializeJson x:TypeArguments="njl:JObject" JsonSample="{x:Null}" Settings="{x:Null}" DisplayName="Deserialize Health JSON" JsonObject="[healthJson]" JsonString="[responseBody]" />
                      <Assign DisplayName="Read Reported State">
                        <Assign.To><OutArgument x:TypeArguments="x:String">[reportedState]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:String">[healthJson.SelectToken("status").ToString.ToLowerInvariant]</InArgument></Assign.Value>
                      </Assign>
                      <Assign DisplayName="Read Health Message">
                        <Assign.To><OutArgument x:TypeArguments="x:String">[reason]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:String">[healthJson.SelectToken("message").ToString]</InArgument></Assign.Value>
                      </Assign>
                      <Assign DisplayName="Classify HTTP Response">
                        <Assign.To><OutArgument x:TypeArguments="x:String">[currentState]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:String">[If(httpStatus = 200 AndAlso reportedState = "healthy", "Healthy", "Degraded")]</InArgument></Assign.Value>
                      </Assign>
                    </Sequence>
                  </TryCatch.Try>
                  <TryCatch.Catches>
                    <ActivityAction x:TypeArguments="s:Exception">
                      <ActivityAction.Argument>
                        <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
                      </ActivityAction.Argument>
                      <Sequence DisplayName="Classify Connection Failure">
                        <Assign DisplayName="Measure Failed Request Time">
                          <Assign.To><OutArgument x:TypeArguments="x:Int64">[responseTimeMs]</OutArgument></Assign.To>
                          <Assign.Value><InArgument x:TypeArguments="x:Int64">[CLng((DateTime.UtcNow - requestStartedUtc).TotalMilliseconds)]</InArgument></Assign.Value>
                        </Assign>
                        <Assign DisplayName="Set Down State">
                          <Assign.To><OutArgument x:TypeArguments="x:String">[currentState]</OutArgument></Assign.To>
                          <Assign.Value><InArgument x:TypeArguments="x:String">Down</InArgument></Assign.Value>
                        </Assign>
                        <Assign DisplayName="Capture Failure Reason">
                          <Assign.To><OutArgument x:TypeArguments="x:String">[reason]</OutArgument></Assign.To>
                          <Assign.Value><InArgument x:TypeArguments="x:String">[exception.GetType.Name &amp; ": " &amp; exception.Message]</InArgument></Assign.Value>
                        </Assign>
                      </Sequence>
                    </ActivityAction>
                  </TryCatch.Catches>
                </TryCatch>

                <Assign DisplayName="Set UTC Timestamp">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[timestampUtc]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[DateTime.UtcNow.ToString("o")]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Determine Transition Action">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[transitionAction]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String" xml:space="preserve">[If(previousState = "Unknown", "Initialization",
If(previousState = currentState, "None",
If(currentState = "Healthy", "RecoveryPending",
If(currentState = "Down" AndAlso previousState = "Degraded", "CriticalEscalationPending",
If(currentState = "Down", "CriticalPending", "WarningPending")))))]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Set Alert Required">
                  <Assign.To><OutArgument x:TypeArguments="x:Boolean">[alertRequired]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Boolean">[transitionAction.EndsWith("Pending", StringComparison.Ordinal)]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Increment Total Checks">
                  <Assign.To><OutArgument x:TypeArguments="x:Int32">[totalChecks]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Int32">[totalChecks + 1]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Increment Healthy Checks">
                  <Assign.To><OutArgument x:TypeArguments="x:Int32">[healthyChecks]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Int32">[healthyChecks + If(currentState = "Healthy", 1, 0)]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Increment Degraded Checks">
                  <Assign.To><OutArgument x:TypeArguments="x:Int32">[degradedChecks]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Int32">[degradedChecks + If(currentState = "Degraded", 1, 0)]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Increment Down Checks">
                  <Assign.To><OutArgument x:TypeArguments="x:Int32">[downChecks]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Int32">[downChecks + If(currentState = "Down", 1, 0)]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Increment Incident Count">
                  <Assign.To><OutArgument x:TypeArguments="x:Int32">[incidentCount]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Int32">[incidentCount + If(transitionAction = "WarningPending" OrElse transitionAction = "CriticalPending", 1, 0)]</InArgument></Assign.Value>
                </Assign>
                <Assign DisplayName="Increment Recovery Count">
                  <Assign.To><OutArgument x:TypeArguments="x:Int32">[recoveryCount]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Int32">[recoveryCount + If(transitionAction = "RecoveryPending", 1, 0)]</InArgument></Assign.Value>
                </Assign>
                <If DisplayName="Record Incident Timestamps" Condition="[transitionAction = &quot;WarningPending&quot; OrElse transitionAction = &quot;CriticalPending&quot; OrElse transitionAction = &quot;CriticalEscalationPending&quot;]">
                  <If.Then>
                    <Sequence DisplayName="Update Incident Timestamps">
                      <If DisplayName="Record First Incident" Condition="[String.IsNullOrEmpty(firstIncidentUtc)]">
                        <If.Then>
                          <Assign DisplayName="Set First Incident UTC">
                            <Assign.To><OutArgument x:TypeArguments="x:String">[firstIncidentUtc]</OutArgument></Assign.To>
                            <Assign.Value><InArgument x:TypeArguments="x:String">[timestampUtc]</InArgument></Assign.Value>
                          </Assign>
                        </If.Then>
                      </If>
                      <Assign DisplayName="Set Last Incident UTC">
                        <Assign.To><OutArgument x:TypeArguments="x:String">[lastIncidentUtc]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:String">[timestampUtc]</InArgument></Assign.Value>
                      </Assign>
                    </Sequence>
                  </If.Then>
                </If>
                <If DisplayName="Accumulate HTTP Response Time" Condition="[httpStatus &gt; 0]">
                  <If.Then>
                    <Sequence DisplayName="Update Response Time Statistics">
                      <Assign DisplayName="Add Response Time">
                        <Assign.To><OutArgument x:TypeArguments="x:Double">[responseTimeTotals(serviceName)]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Double">[responseTimeTotals(serviceName) + CDbl(responseTimeMs)]</InArgument></Assign.Value>
                      </Assign>
                      <Assign DisplayName="Increment Response Count">
                        <Assign.To><OutArgument x:TypeArguments="x:Int32">[responseTimeCounts(serviceName)]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Int32">[responseTimeCounts(serviceName) + 1]</InArgument></Assign.Value>
                      </Assign>
                    </Sequence>
                  </If.Then>
                </If>
                <Assign DisplayName="Build CSV Row">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[csvLine]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String" xml:space="preserve">[timestampUtc &amp; "," &amp; serviceName &amp; "," &amp; previousState &amp; "," &amp; currentState &amp; "," &amp;
httpStatus.ToString &amp; "," &amp; responseTimeMs.ToString &amp; "," &amp;
reason.Replace(",", ";").Replace(vbCr, " ").Replace(vbLf, " ") &amp; ",False," &amp;
transitionAction &amp; "," &amp; runId]</InArgument></Assign.Value>
                </Assign>
                <ui:AppendLine DisplayName="Append Monitoring CSV Row" FileName="[logPath]" Text="[csvLine]" />
                <WriteLine DisplayName="Write Normalized Result" Text="[timestampUtc &amp; &quot; | Service=&quot; &amp; serviceName &amp; &quot; | Previous=&quot; &amp; previousState &amp; &quot; | Current=&quot; &amp; currentState &amp; &quot; | HTTP=&quot; &amp; httpStatus.ToString &amp; &quot; | MeasuredMs=&quot; &amp; responseTimeMs.ToString &amp; &quot; | Transition=&quot; &amp; transitionAction &amp; &quot; | Reason=&quot; &amp; reason]" />
                <Assign DisplayName="Store Current State">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[previousStates(serviceName)]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[currentState]</InArgument></Assign.Value>
                </Assign>
              </Sequence>
            </ActivityAction>
          </ui:ForEach.Body>
        </ui:ForEach>
        <Assign DisplayName="Increment Cycle">
          <Assign.To><OutArgument x:TypeArguments="x:Int32">[currentCycle]</OutArgument></Assign.To>
          <Assign.Value><InArgument x:TypeArguments="x:Int32">[currentCycle + 1]</InArgument></Assign.Value>
        </Assign>
        <If DisplayName="Wait Before Next Cycle" Condition="[currentCycle &lt; maxCycles]">
          <If.Then>
            <Delay DisplayName="Polling Interval" Duration="[TimeSpan.FromSeconds(pollIntervalSeconds)]" />
          </If.Then>
        </If>
      </Sequence>
    </While>

    <WriteLine DisplayName="Write Final Summary" Text="[&quot;FINAL SUMMARY | RunId=&quot; &amp; runId &amp; &quot; | Total=&quot; &amp; totalChecks.ToString &amp; &quot; | Healthy=&quot; &amp; healthyChecks.ToString &amp; &quot; | Degraded=&quot; &amp; degradedChecks.ToString &amp; &quot; | Down=&quot; &amp; downChecks.ToString &amp; &quot; | Incidents=&quot; &amp; incidentCount.ToString &amp; &quot; | Recoveries=&quot; &amp; recoveryCount.ToString &amp; &quot; | FirstIncident=&quot; &amp; If(String.IsNullOrEmpty(firstIncidentUtc), &quot;None&quot;, firstIncidentUtc) &amp; &quot; | LastIncident=&quot; &amp; If(String.IsNullOrEmpty(lastIncidentUtc), &quot;None&quot;, lastIncidentUtc) &amp; &quot; | Log=&quot; &amp; logPath]" />
    <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="Write Average Response Times" Values="[serviceDefinitions]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:String" Name="summaryServiceDefinition" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Write Service Average">
            <Assign DisplayName="Read Summary Service Name">
              <Assign.To><OutArgument x:TypeArguments="x:String">[serviceName]</OutArgument></Assign.To>
              <Assign.Value><InArgument x:TypeArguments="x:String">[summaryServiceDefinition.Split("|"c)(0)]</InArgument></Assign.Value>
            </Assign>
            <WriteLine DisplayName="Write Average Response Time" Text="[&quot;AVERAGE | Service=&quot; &amp; serviceName &amp; &quot; | ResponseMs=&quot; &amp; If(responseTimeCounts(serviceName) &gt; 0, Math.Round(responseTimeTotals(serviceName) / responseTimeCounts(serviceName), 2).ToString, &quot;N/A&quot;)]" />
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
  </Sequence>
</Activity>

